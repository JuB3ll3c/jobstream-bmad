# Copy to `.env` and fill real values — never commit `.env`.
# `docker compose` reads `.env` automatically for ${VAR} interpolation.

# PostgreSQL (local infra)
POSTGRES_DB=jobstream
POSTGRES_USER=jobstream
POSTGRES_PASSWORD=change-me

# Kafka bootstrap for services inside the compose network
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Service API keys (later stories) ---
# JSEARCH_API_KEY=
# ADZUNA_APP_ID=
# ADZUNA_APP_SECRET=
# OPENAI_API_KEY=
